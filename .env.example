# DISCORD
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_BOT_TOKEN=your_bot_token
GUILD_ID=your_server_id
OWNER_DISCORD_ID=your_discord_user_id
STAFF_ROLE_ID=your_staff_role_id
VERIFIED_ROLE_ID=your_verified_role_id
BLACKLIST_ROLE_ID=your_blacklist_role_id

# NEXTAUTH
NEXTAUTH_SECRET=generate_a_32_character_random_string_here
NEXTAUTH_URL=http://localhost:3000

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# BOT HEALTH (website checks this before accepting verifications)
# Example: http://localhost:8080 or https://my-discord-bot-3vvc.onrender.com
BOT_HEALTH_URL=https://my-discord-bot-3vvc.onrender.com

# WEBSITE (used in bot DMs)
WEBSITE_URL=http://localhost:3000

# LOCAL DEV ONLY — skip Discord login on localhost (never enable in production)
DEV_BYPASS_AUTH=false
NEXT_PUBLIC_DEV_BYPASS_AUTH=false